SERVICE_NAME=AuthService
SERVICE_PORT=8081

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=paylaterdb

JWT_SECRET=change_me_jwt_secret
INTERNAL_API_TOKEN=change_me_internal_token

# RSA private key (PEM) used to decrypt login credentials encrypted by the frontend.
# Generate locally: go run scripts/setup_login_key.go
# Or: openssl genrsa -out login_private.pem 2048
LOGIN_RSA_PRIVATE_KEY=
